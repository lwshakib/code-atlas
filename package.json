{
  "name": "code-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "bun x prisma generate",
    "db:generate": "bun x prisma generate",
    "db:migrate": "bun x prisma generate && bun x prisma migrate dev --name init",
    "db:studio": "bun x prisma studio",
    "db:reset": "bun x prisma migrate reset",
    "db:reset:external": "bun run scripts/reset-databases.ts",
    "db:reset:all": "bun run db:reset --force && bun run db:reset:external",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
